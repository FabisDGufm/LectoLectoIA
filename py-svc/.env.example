# ================================================
# CONFIGURACIÓN DEL SERVICIO PYTHON - LECTOLECTO
# ================================================

# Entorno de Flask
FLASK_APP=app.py
FLASK_ENV=development

# Puerto del servicio
PORT=5000

# CORS
CORS_ORIGIN=http://localhost:4200

# URL del backend Node.js
BACKEND_URL=http://localhost:4000

# ================================================
# TESSERACT OCR (opcional, si se instala)
# ================================================

# Windows: Ruta donde está instalado Tesseract
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Linux/Mac: Por defecto busca en PATH
# TESSERACT_CMD=/usr/bin/tesseract

# ================================================
# OLLAMA (para futuras fases con IA local)
# ================================================

# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama2

# ================================================
# CHROMADB (para futuras fases con embeddings)
# ================================================

# CHROMADB_PATH=./data/chromadb
